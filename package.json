  "description": "MCP server that boots boat.dev sandboxes as linked T3 Code environments for subagents, and cleans them up when done.",
  "type": "module",
  "private": true,
  "bin": {
    "t3boat": "./bin/t3boat.mjs"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
